[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "git-demo"]
	url = https://github.com/Dxw-has/git-demo.git
	fetch = +refs/heads/*:refs/remotes/git-demo/*
[branch "master"]
	remote = git-demo
	merge = refs/heads/master
